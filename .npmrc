# Supply-chain hardening (matches the other NEMTUS npm repos).
# Lifecycle scripts never run on install; build steps are invoked explicitly (`npm run build`).
# This also skips the upstream prepack/postpack hooks: CI and the publish workflow build and pack
# explicitly instead.
ignore-scripts=true
# Delay adopting freshly published versions on `npm install` / Dependabot bumps (does not gate
# `npm ci`, which installs the lockfile; known vulnerabilities are gated by `npm audit` in CI).
min-release-age=7
